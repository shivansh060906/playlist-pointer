# Copy to .env and fill in. Only the LLM key is required (and only for /api/ask).

# --- LLM for answers: pick one provider ---------------------------------------------------
# groq | gemini
LLM_PROVIDER=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval models (downloaded from Hugging Face on first run) ---------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# fixed | sliding | semantic
DEFAULT_STRATEGY=semantic

# --- Data ------------------------------------------------------------------------------------
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLlrATfBNZ98dudnM48yfGUldqGD0S4FFb
DATA_DIR=./data

# --- Server ----------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 1 = load models at startup in the background
WARMUP=1
LEAD_IN_SECONDS=2
