# Copy to .env and fill in. Only the LLM key is required (and only for /api/ask).

# --- LLM for answers: pick one provider ---------------------------------------------------
# groq | gemini
LLM_PROVIDER=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval models (downloaded from Hugging Face on first run) ---------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# fixed | sliding | semantic
DEFAULT_STRATEGY=semantic
# Hybrid fusion weights "dense,bm25". Equal weights (1,1) let the weaker BM25 list drag results down.
RRF_WEIGHTS=2,1
# Refuse queries unrelated to the lectures: if the best dense cosine is below this AND the query has no
# rare in-corpus term, the API flags out_of_scope. 0 disables. Calibrate: python -m scripts.calibrate
MIN_RELEVANCE=0.55

# Playlists added from the web UI are capped at this many videos (caption fetching is ~1-3 s per video).
MAX_PLAYLIST_VIDEOS=60

# --- Data ------------------------------------------------------------------------------------
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLlrATfBNZ98dudnM48yfGUldqGD0S4FFb
DATA_DIR=./data

# --- Server ----------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 1 = load models at startup in the background
WARMUP=1
LEAD_IN_SECONDS=2
